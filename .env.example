# 复旦大学账号配置
FUDAN_USERNAME=你的学号
FUDAN_PASSWORD=你的密码

# 邮件配置 (以QQ邮箱为例)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
EMAIL_SENDER=你的邮箱@qq.com
EMAIL_PASSWORD=邮箱授权码（不是登录密码）
EMAIL_RECEIVER=接收通知的邮箱

# 检测配置
CHECK_INTERVAL_MINUTES=15
HEADLESS=true

# 学期配置 (可选)
# 格式: YYYY-YYYY-N (例如 2025-2026-1 表示2025-2026学年第1学期)
# 留空则自动获取当前学期
CURRENT_SEMESTER=2025-2026-1
INFER_GRADES=true

# P/NP 课程自动识别 (可选)
# 设为 false 可关闭 P/NP 课程自动识别
# 关闭后，推断绩点接近0的情况不会被标记为P/NP（避免"新课程绩点恰好等于原绩点"的误判）
INFER_PNP=false

# 开启院系排名监控 (可选, 默认为 false)
ENABLE_DEPARTMENT_MONITORING=true
DEPARTMENT_NAME=您的院系名称